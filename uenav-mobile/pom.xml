<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.uenav</groupId>
    <artifactId>uenav-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>uenav-mobile</artifactId>
  <name>UENav</name>

  <properties>
    <main.class>com.uenav.mobile.MobileApp</main.class>
    <app.identifier>com.uenav.mobile</app.identifier>
    <app.description>UENav campus navigator</app.description>
    <version.code>1</version.code>
    <provided.keystore.path/>
    <provided.keystore.password/>
    <provided.key.alias/>
    <provided.key.alias.password/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.uenav</groupId>
      <artifactId>uenav-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>Gluon</id>
      <url>https://nexus.gluonhq.com/nexus/content/repositories/releases</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.gluonhq</groupId>
        <artifactId>gluonfx-maven-plugin</artifactId>
        <version>${gluonfx.maven.plugin.version}</version>
        <configuration>
          <verbose>true</verbose>
          <target>${gluonfx.target}</target>
          <mainClass>${main.class}</mainClass>
          <appIdentifier>${app.identifier}</appIdentifier>
          <releaseConfiguration>
            <vendor>UENav</vendor>
            <description>${app.description}</description>
            <versionCode>${version.code}</versionCode>
            <providedKeyStorePath>${provided.keystore.path}</providedKeyStorePath>
            <providedKeyStorePassword>${provided.keystore.password}</providedKeyStorePassword>
            <providedKeyAlias>${provided.key.alias}</providedKeyAlias>
            <providedKeyAliasPassword>${provided.key.alias.password}</providedKeyAliasPassword>
          </releaseConfiguration>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>desktop</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <gluonfx.target>host</gluonfx.target>
      </properties>
    </profile>
    <profile>
      <id>android</id>
      <properties>
        <gluonfx.target>android</gluonfx.target>
        <version.code>${env.GITHUB_RUN_NUMBER}</version.code>
      </properties>
    </profile>
  </profiles>
</project>
